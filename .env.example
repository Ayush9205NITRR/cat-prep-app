# Neon: `neon deploy` / `neon env pull` writes these two. On Vercel, set both.
# Pooled (-pooler host): used by the app.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (no -pooler): used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional: "Continue with Google". Without these the button is hidden.
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application),
# authorised redirect URI: https://<your-app>/api/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
